{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "podbench Helm chart",
    "description": "RBAC, workspace claims and seat identity for podbench",
    "type": "object",
    "properties": {
        "commonAnnotations": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "commonLabels": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "fullnameOverride": {
            "type": "string"
        },
        "global": {
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as the `additionalProperties` setting would otherwise collide with Helm's special 'global' values key.",
            "type": [
                "object",
                "null"
            ]
        },
        "hotfixVenv": {
            "type": "object",
            "properties": {
                "claims": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "size": {
                                "type": "string"
                            },
                            "storageClassName": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "enabled": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "nameOverride": {
            "type": "string"
        },
        "rbac": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "hotfix": {
                    "type": "boolean"
                },
                "iterate": {
                    "type": "boolean"
                },
                "observe": {
                    "type": "boolean"
                },
                "resize": {
                    "type": "boolean"
                },
                "subjects": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "kind",
                            "name"
                        ],
                        "properties": {
                            "apiGroup": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "User",
                                    "Group",
                                    "ServiceAccount"
                                ]
                            },
                            "name": {
                                "type": "string"
                            },
                            "namespace": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "scratchPvc": {
            "type": "object",
            "properties": {
                "accessModes": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "ReadWriteOnce",
                            "ReadOnlyMany",
                            "ReadWriteMany",
                            "ReadWriteOncePod"
                        ]
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "size": {
                    "type": "string"
                },
                "storageClassName": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "seatIdentity": {
            "type": "object",
            "properties": {
                "apps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "uid",
                            "gid"
                        ],
                        "properties": {
                            "configMapName": {
                                "type": "string"
                            },
                            "gid": {
                                "type": "integer"
                            },
                            "name": {
                                "type": "string"
                            },
                            "uid": {
                                "type": "integer"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "enabled": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
